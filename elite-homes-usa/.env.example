# Local demo mode writes submissions to SQLite and shows a preview notice.
ELITE_MODE=preview
# Set a unique secret of at least 32 characters to activate the owner inbox.
ELITE_ADMIN_SECRET=
# Or set a friendly admin password for dashboard sign-in.
ELITE_ADMIN_PASSWORD=EliteHomesAdmin2026!
# Use a persistent private volume for production.
ELITE_DATA_PATH=.data/elite.sqlite
ELITE_MEDIA_PATH=.data/media
# Set the canonical HTTPS URL for the production sitemap and social metadata.
ELITE_SITE_URL=
